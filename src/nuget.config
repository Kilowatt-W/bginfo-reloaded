<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Projektlokale Paketquelle, damit der Build auch auf Rechnern funktioniert, auf denen global
       nur die "Visual Studio Offline Packages" eingerichtet sind. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
